#include <stdio.h>

void insertionsort(int arr[],int n)
{
  for (int i=1;i<n;i++)
  {
    int key=arr[i]; //key is the value of unsorted  
    j=i-1; //j is the index of the left most sorted value
    
    //Need to check if the sorted value is greater than key value

    while (j>=0 && arr[j]>key)
    {
      arr[j+1]=arr[j]; //shifting the sorted value to a single step right
      j=j-1; //For looping inside the sorted array from right to left,at the end j will point one index down to the actual index , thats why key is inserted at j+1 th index
    }
